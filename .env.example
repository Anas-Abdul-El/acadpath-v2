# Connection string for your external PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Auth: long random strings (32+ chars), a different one for each (e.g. `openssl rand -base64 48`)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# AI (OpenRouter). The key stays on the server; the model is optional (v1's default)
OPENROUTER_KEY=
# OPENROUTER_MODEL=
# Job queues. Compose sets this to its redis service; set it when running the backend outside Compose
REDIS_URL=redis://localhost:6379
# Vision-capable model ID on OpenRouter, for images and scanned PDFs (required, no default)
OPENROUTER_VISION_MODEL=
# Uploaded files (any S3-compatible storage). Compose runs SeaweedFS and sets the endpoint;
# leave S3_ENDPOINT unset for AWS S3. Pick your own keys for local SeaweedFS.
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
S3_BUCKET=acadpath-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKEND_PORT=4000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Frontend origins (comma-separated, no path). Also the only origins allowed to open the
# student-portal WebSocket. Defaults to http://localhost:3000.
# CORS_ORIGIN=http://localhost:3000
# Student-portal browser (transcript import). All optional; defaults target LIU.
# PORTAL_START_URL=https://syslbv4.liu.edu.lb/login/
# Comma-separated domains the browser may navigate to (subdomains included)
# PORTAL_ALLOWED_HOSTS=liu.edu.lb
# Max browsers open at once, and minutes before an unwatched one is closed
# PORTAL_MAX_SESSIONS=5
# PORTAL_IDLE_MINUTES=10
